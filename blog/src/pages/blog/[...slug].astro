---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, getPublishedPosts, readingTime, tagSlug, url, type Post } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    // Posts are newest first, so the next-older post follows this one.
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

interface Props {
  post: Post;
  newer?: Post;
  older?: Post;
}

const { post, newer, older } = Astro.props;
const { Content, headings } = await render(post);
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
---
<BaseLayout title={post.data.title} description={post.data.description} type="article">
  <article>
    <a href={url()} class="text-sm text-zinc-500 hover:text-accent-600 dark:hover:text-accent-400">← All posts</a>
    <header class="mt-6 mb-10">
      <div class="flex flex-wrap items-center gap-2 text-sm text-zinc-500">
        <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
        <span aria-hidden="true">·</span>
        <span>{readingTime(post.body)}</span>
        {post.data.updatedDate && (
          <>
            <span aria-hidden="true">·</span>
            <span>Updated {formatDate(post.data.updatedDate)}</span>
          </>
        )}
        {post.data.draft && <span class="rounded bg-amber-100 px-1.5 py-0.5 text-xs font-medium text-amber-800">Draft</span>}
      </div>
      <h1 class="mt-3 text-3xl font-bold tracking-tight text-zinc-900 sm:text-4xl dark:text-zinc-100">{post.data.title}</h1>
      <p class="mt-3 text-lg text-zinc-600 dark:text-zinc-400">{post.data.description}</p>
      {post.data.tags.length > 0 && (
        <ul class="mt-4 flex flex-wrap gap-2">
          {post.data.tags.map((tag) => (
            <li>
              <a href={url(`tags/${tagSlug(tag)}/`)} class="rounded-full border border-zinc-200 px-3 py-1 text-xs font-medium text-zinc-600 hover:border-accent-500 hover:text-accent-600 dark:border-zinc-800 dark:text-zinc-400">#{tag}</a>
            </li>
          ))}
        </ul>
      )}
    </header>

    {toc.length > 2 && (
      <nav aria-label="On this page" class="mb-10 rounded-lg border border-zinc-200 p-4 text-sm dark:border-zinc-800">
        <p class="mb-2 font-semibold text-zinc-900 dark:text-zinc-100">On this page</p>
        <ul class="space-y-1">
          {toc.map((h) => (
            <li class:list={[{ 'pl-4': h.depth === 3 }]}>
              <a href={`#${h.slug}`} class="text-zinc-600 hover:text-accent-600 dark:text-zinc-400 dark:hover:text-accent-400">{h.text}</a>
            </li>
          ))}
        </ul>
      </nav>
    )}

    <div class="prose prose-zinc max-w-none dark:prose-invert prose-headings:scroll-mt-20 prose-headings:tracking-tight prose-a:text-accent-600 dark:prose-a:text-accent-400 prose-code:before:content-none prose-code:after:content-none prose-code:rounded prose-code:bg-zinc-100 prose-code:px-1 prose-code:py-0.5 prose-code:font-normal dark:prose-code:bg-zinc-800 prose-pre:bg-transparent">
      <Content />
    </div>
  </article>

  {(newer || older) && (
    <nav aria-label="More posts" class="mt-16 grid gap-4 border-t border-zinc-200 pt-8 sm:grid-cols-2 dark:border-zinc-800">
      {older ? (
        <a href={url(`blog/${older.id}/`)} class="group rounded-lg border border-zinc-200 p-4 hover:border-accent-500 dark:border-zinc-800">
          <span class="text-xs text-zinc-500">← Previous</span>
          <span class="mt-1 block font-medium text-zinc-900 group-hover:text-accent-600 dark:text-zinc-100">{older.data.title}</span>
        </a>
      ) : <span />}
      {newer && (
        <a href={url(`blog/${newer.id}/`)} class="group rounded-lg border border-zinc-200 p-4 text-right hover:border-accent-500 dark:border-zinc-800">
          <span class="text-xs text-zinc-500">Next →</span>
          <span class="mt-1 block font-medium text-zinc-900 group-hover:text-accent-600 dark:text-zinc-100">{newer.data.title}</span>
        </a>
      )}
    </nav>
  )}
</BaseLayout>
