---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { countTags, formatDate, getPublishedPosts, tagSlug, url, type Post } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return countTags(posts).map(([tag]) => ({
    params: { tag: tagSlug(tag) },
    props: { tag, posts: posts.filter((p) => p.data.tags.includes(tag)) },
  }));
}

interface Props {
  tag: string;
  posts: Post[];
}

const { tag, posts } = Astro.props;
---
<BaseLayout title={`#${tag}`} description={`Posts tagged ${tag}.`}>
  <a href={url('tags/')} class="text-sm text-zinc-500 hover:text-accent-600">← All tags</a>
  <h1 class="mt-4 text-3xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100">#{tag}</h1>
  <p class="mt-2 text-zinc-600 dark:text-zinc-400">{posts.length} {posts.length === 1 ? 'post' : 'posts'}</p>
  <ul class="mt-8 space-y-4">
    {posts.map((post) => (
      <li class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:gap-4">
        <time class="shrink-0 text-sm text-zinc-500 sm:w-28" datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
        <a href={url(`blog/${post.id}/`)} class="font-medium text-zinc-900 hover:text-accent-600 dark:text-zinc-100 dark:hover:text-accent-400">{post.data.title}</a>
      </li>
    ))}
  </ul>
</BaseLayout>
