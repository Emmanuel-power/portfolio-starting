---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { countTags, getPublishedPosts, tagSlug, url } from '../../lib/posts';

const tags = countTags(await getPublishedPosts());
---
<BaseLayout title="Tags" description="Browse posts by topic.">
  <h1 class="text-3xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100">Tags</h1>
  <p class="mt-2 text-zinc-600 dark:text-zinc-400">Browse posts by topic.</p>
  <ul class="mt-8 flex flex-wrap gap-3">
    {tags.map(([tag, count]) => (
      <li>
        <a href={url(`tags/${tagSlug(tag)}/`)} class="inline-flex items-center gap-2 rounded-full border border-zinc-200 px-4 py-2 text-sm font-medium hover:border-accent-500 hover:text-accent-600 dark:border-zinc-800 dark:hover:text-accent-400">
          #{tag}
          <span class="rounded-full bg-zinc-100 px-2 text-xs text-zinc-600 dark:bg-zinc-800 dark:text-zinc-400">{count}</span>
        </a>
      </li>
    ))}
  </ul>
</BaseLayout>
