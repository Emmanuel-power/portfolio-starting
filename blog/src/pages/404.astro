---
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../lib/posts';
---
<BaseLayout title="Page not found">
  <div class="py-16 text-center">
    <p class="font-mono text-sm text-accent-600">404</p>
    <h1 class="mt-2 text-3xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100">This page wandered off</h1>
    <p class="mt-3 text-zinc-600 dark:text-zinc-400">The link may be broken, or the post may have moved.</p>
    <a href={url()} class="mt-8 inline-block rounded-lg bg-accent-600 px-4 py-2 text-sm font-medium text-white hover:bg-accent-500">Back to the blog</a>
  </div>
</BaseLayout>
